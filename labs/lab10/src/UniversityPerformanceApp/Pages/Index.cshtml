@page
@model IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>University Performance</h1>

@if (Model.Error is not null)
{
    <p class="message error">@Model.Error</p>
}
else if (Model.Data is not null)
{
    <section class="statistics">
        <article>
            <strong>@Model.Data.Students</strong>
            <span>Students</span>
        </article>
        <article>
            <strong>@Model.Data.Disciplines</strong>
            <span>Disciplines</span>
        </article>
        <article>
            <strong>@Model.Data.Records</strong>
            <span>Grade records</span>
        </article>
        <article>
            <strong>@Model.Data.Average</strong>
            <span>Average grade</span>
        </article>
    </section>
}
